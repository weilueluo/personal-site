# Public analytics
NEXT_PUBLIC_G_TAG=G-XXXXXXXXXX

# GitHub (read-only token for blog content)
GITHUB_TOKEN=ghp_your_read_only_token

# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
# Use secret key for server operations; publishable key works with RLS enabled.
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Postmark
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=sender@your-domain.com
POSTMARK_TO=receiver@your-domain.com
# Optional: specific message stream
POSTMARK_MESSAGE_STREAM=outbound

# Optional revalidate override
DEFAULT_REVALIDATE=0
